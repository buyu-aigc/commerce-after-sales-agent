OPENAI_API_KEY=sk-your-key-here

# Current V2 OpenAI-compatible provider: DeepSeek (replace the placeholder key above)
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# deepseek-flash reasons before answering, so a single call can take tens of seconds.
LLM_TIMEOUT_SECONDS=120
CUSTOMER_PLAN_TIMEOUT_SECONDS=120
# Leave unset to auto-detect: DeepSeek does not honour native structured output, so JSON text is used.
# OPENAI_NATIVE_STRUCTURED_OUTPUT=1
DEMO_MODE=0

# Evaluated configuration: task contract planning + tiered confirmation cards
CUSTOMER_PLANNING_MODE=contract
CUSTOMER_WRITE_CONFIRMATION=1
# Every write waits for a click (default: only writes that take effect on their own, and withdrawals)
# CUSTOMER_CONFIRMATION_SCOPE=all
# Held-out account (18 orders): uncomment to add the evaluation orders to the demo customer
# DEMO_CUSTOMER_ORDER_IDS=0c4d07bcd65a6ce95cbe8e8e228a98cf,6b87abf6bcb0f682e0cc2809d921a778,002f19a65a2ddd70a090297872e6d64e,0d694d4d413750922e42f63577896916,266fd5134fd1b895a5b06936d51aaa17,3853bb442103dd1f77271b7750bd3202,778d6f8f92b218606a82dc5d2f5221e2,0241b276e1e2b1d6873473c44240b426,9a44abc905204e1ab8b71a8b7cb4b838,90207c312f193fbd229671833bf08d47,d1ca0c1c5f78ecd17ab721d805629eb7,b6ac9e1564a4ab43f7958280ebc3ea23,5f787bb3e0a01a4f347192157c036791

# A placeholder key keeps the client offline. Do not commit a real key.
# Optional — other OpenAI-compatible providers, for example the previous default
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen3.8-27b
# OPENAI_NATIVE_STRUCTURED_OUTPUT=1

# Olist derived runtime dataset
# OLIST_AGENT_DATASET_PATH=data/olist_derived/agent_records.json
# OLIST_ORDER_FACTS_PATH=data/olist_derived/order_facts_index.json
# OLIST_CATEGORY_RISK_PATH=data/olist_derived/category_risk_index.json

# Optional — external MCP demo for payment/refund side effects
# STRIPE_API_KEY=sk_test_your_stripe_sandbox_key
# STRIPE_MCP_URL=https://mcp.stripe.com

# Optional — multi-worker runtime coordination
# RUNTIME_STORE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
# REDIS_PREFIX=olist-agent
# AGENT_RATE_LIMIT_PER_MINUTE=120
